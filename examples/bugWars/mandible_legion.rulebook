          ]
        },
        "stats": {
          "Command Cost": {
            "value": 1
          }
        },
        "text": "**WHEN**: Your Movement phase.\n\n**TARGET**: One Mandible Legion unit from your army.\n\n**EFFECT**: Until the end of the turn, your unit is eligible to shoot in a turn in which it Advanced or Fell Back."
      },
      "Hive-Tactic§No Threat Too Great": {
        "keywords": {
          "Keywords": [
            "Burrow-Anvil Siege",
            "Mandible Legion"
          ],
          "Phase": [
            "Shooting"
          ],
          "Turn": [
