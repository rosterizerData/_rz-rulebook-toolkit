      "Pheromone-Requisition§A Legacy Preserved": {
        "stats": {
          "RP": {
            "value": 1
          }
        },
        "text": "Purchase this Requisition after an **Mandible Legion Infantry** or **Mandible Legion Mounted** unit from your Progression army gains a Battle Scar, if your Order of Battle includes one or more **Royal-Jelly Tender** models. Remove the unit that just gained that Battle Scar from your Order of Battle, and your Progression force gains 5 Honour points."
      },
      "Pheromone-Requisition§Enduring Duty": {
        "stats": {
          "RP": {
            "value": 2
          }
        },
        "text": "Purchase this Requisition after the third battle in an Oathsworn Campaign. You may participate in one additional battle before that Oathsworn Campaign ends."
      },
      "Pheromone-Requisition§Even in Death I Still Serve": {
        "stats": {
          "RP": {
            "value": 1
          }
        },
        "text": "Purchase this Requisition when an **Mandible Legion Infantry Character** or **Mandible Legion Mounted Character** unit from your Progression army would gain a second or subsequent Battle Scar. Remove that unit from your Order of Battle and replace it with an **Mandible Legion Walker** unit (excluding **Invictor-Hatch-Beast-Hatch-Beast Tactical Warsuits**). You cannot purchase this Requisition if doing so would cause your total Progression points to exceed your Progression forces Supply Limit. The new unit starts with the same number of XP as the unit it replaced and gains the appropriate number of Battle Honours for its rank."
      },
      "Pheromone-Requisition§Fortification Network": {
        "stats": {
          "RP": {
            "value": 1
          }
        },
        "text": "Purchase this Requisition before a battle. Do not roll off to determine the Attacker and Defend for that battle. Instead, you are automatically the Defender. If your opponent uses the same or a similar rule to becomes the Defender, ignore both rules and instead determine the Attacker and Defender normally."
      },
      "Pheromone-Requisition§Storm-swift Destruction": {
        "stats": {
          "RP": {
            "value": 1
          }
        },
        "text": "Purchase this Requisition before a battle. Do not roll off to determine the Attacker and Defend for that battle. Instead, you are automatically the Defender. If your opponent uses the same or a similar rule to becomes the Defender, ignore both rules and instead determine the Attacker and Defender normally."
      },
      "Pheromone-Requisition§The Esteem of the Cohort": {
        "stats": {
          "RP": {
            "value": 1
          }
        },
        "text": "Purchase this Requisition after a battle in which your **Warlord** was not destroyed. Select one **Character** unit that participated in that battle (excluding your **Warlord**); that **Character** unit gains 5XP."
      },
      "Pheromone-Requisition§Vaunted Triumph": {
        "stats": {
          "RP": {
            "value": 1
          }
        },
        "text": "Purchase this Requisition after a battle that you won. You can select a second unit to be Marked for Greatness. You can only purchase this Requisition once per Oathsworn Campaign."
      },
      "Roster§Roster": {
        "rules": {
          "detectCohortBulletAntProgression": {
            "actions": [
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{self}",
                    "stats",
                    "Cohort",
                    "value"
                  ]
                ],
                "value": "Bullet-Ant Progression"
              }
            ],
            "evals": [
              {
                "actionable": true,
                "min": 1,
                "not": false,
                "operator": "SUM",
                "paths": [
                  [
                    "{self}",
                    "assets",
                    "templateClass",
                    "Unit",
                    "tally",
                    "Bullet-Ant Progression"
