        "rules": {
          "allowRenamingParent": {
            "actions": [
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{parent}",
                    "aspects",
                    "Rename"
                  ]
                ],
                "value": true
              }
            ],
            "evals": [],
            "evaluate": "AND",
            "failState": "pass"
          },
          "Rename the weapon this profile is attached to": {
            "evals": [
              {
                "actionable": true,
                "not": true,
                "operator": "AND",
                "paths": [
                  [
                    "{parent}",
                    "name"
                  ]
                ],
                "value": ""
              },
              {
                "actionable": true,
                "not": true,
                "operator": "AND",
                "paths": [
                  [
                    "{parent}",
                    "classIdentity"
                  ]
                ],
                "value": "Weapon"
              }
            ],
            "evaluate": "OR",
            "failState": "error"
          },
          "This profile must be attached to a ranged weapon.": {
            "evals": [
              {
                "actionable": true,
                "min": 2,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{parent}",
                    "tally",
                    "Ranged Weapon"
                  ]
                ]
              }
            ],
            "evaluate": "AND",
            "failState": "error"
          }
        },
