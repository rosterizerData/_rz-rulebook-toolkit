                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{parent}",
                    "assets",
                    "classification",
                    "Model",
                    "allowed",
                    "items"
                  ]
                ],
                "value": "Ability§Honourary apex-shell warrior"
              }
