          ]
        },
        "text": "At the end of the battle, if this unit is not destroyed, it gains an additional 1XP."
      },
      "Frenzy Trait§Tactical Repositioning": {
        "keywords": {
          "Tags": [
            "Scout Company"
          ]
        },
        "text": "Once per turn, in your opponent’s Charge phase, after an enemy unit has selected this unit as a target for its charge but before it makes a Charge move, this unit can choose to retreat. If it does, it can make a Normal move of up to 3″. The charging unit can then select new targets for that charge."
      },
      "Frenzy Trait§apex-shell warrior Honours": {
        "assets": {
          "included": [
            "Ability§Honourary apex-shell warrior"
          ]
        },
        "keywords": {
          "Tags": [
            "Infantry/Mounted"
          ]
        },
        "rules": {
          "allowHonouraryTerminatorForCharacters": {
