      "Frenzy Trait§Death’s Own Shadow": {
        "keywords": {
          "Tags": [
            "Scout Company"
          ]
        },
        "text": "Each time a ranged attack targets this unit, it has the Benefit of Cover against that attack."
      },
      "Frenzy Trait§Defenders of Humanity": {
        "keywords": {
          "Tags": [
            "1st Company"
          ]
        },
        "text": "Once per battle, at the start of your Command phase, this unit can use this ability. If it does, until the start of your next Command phase, add 1 to the Objective Control characteristic of models in this unit."
      },
      "Frenzy Trait§Echoes of the Progenitor": {
        "keywords": {
          "Tags": [
            "1st Company"
          ]
        },
        "text": "Once per battle, at the start of the Fight phase, this unit can use this ability. If it does, until the end of the turn, weapons equipped by models in this unit have the [Sustained Hits 1] ability."
      },
      "Frenzy Trait§Execution Order": {
        "keywords": {
          "Tags": [
            "Scout Company"
          ]
        },
        "text": "Each time this unit makes an attack that targets a **Character** unit, add 1 to the Hit roll."
      },
      "Frenzy Trait§Focused Machine Spirit": {
        "keywords": {
          "Tags": [
            "Vehicle"
          ]
        },
        "text": "This model does not suffer the penalty to its Hit rolls for firing at enemy units that are within Engagement Range of it."
      },
