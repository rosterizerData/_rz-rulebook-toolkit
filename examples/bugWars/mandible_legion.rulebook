          ]
        },
        "stats": {
          "Command Cost": {
            "value": 2
          }
        },
        "text": "**WHEN:** Your Shooting phase.\n\n**TARGET:** One Mandible Legion unit from your army that has not been selected to shoot this phase. \n\n**EFFECT:** Until the end of the phase, each time a model in your unit makes a ranged attack that targets a Monster or Vehicle unit, you can re-roll the Wound roll."
      },
      "Hive-Tactic§Not One Backwards Step": {
        "keywords": {
          "Keywords": [
            "Burrow-Anvil Siege",
            "Mandible Legion"
          ],
          "Phase": [
            "Command"
          ],
          "Turn": [
