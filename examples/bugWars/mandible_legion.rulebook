    "assetCatalog": {
      "Ability§Aerial Assault": {
        "keywords": {
          "Keywords": [
            "Model Ability"
          ]
        },
        "text": "Each time a unit with the Deep Strike ability disembarks from this model after it has made a Normal move, that unit is still eligible to declare a charge this turn."
      },
      "Ability§Aerial Deployment": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "If this model starts the game in Hover mode and in Strategic Reserves, it can be set up in the Reinforcements step of your first, second or third Movement phase, regardless of any mission rules."
      },
      "Ability§Angel’s Wrath": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, each time that unit ends a Charge move, until the end of the turn, add 1 to the Strength characteristic of melee weapons equipped by models in that unit."
      },
      "Ability§Annihilator": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time a ranged attack made by this model is allocated to a Monster or Vehicle model, you can re‑roll the Damage roll.."
      },
      "Ability§Annihilator Protocols": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Melee weapons equipped by models in this unit have the [SUSTAINED HITS 2] ability when targeting Monster, Vehicle or Fortification units."
      },
      "Ability§Apex-Pattern Optics": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model is selected to shoot, you can re-roll one Hit roll, you can re-roll one Wound roll and you can re-roll one Damage roll when resolving its attacks."
      },
      "Ability§Armorium Cherub": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once per battle, after making a Hit roll for a model in this unit, you can change that roll to an unmodified 6. Designer’s Note: Place an Armorium Cherub token next to the unit, removing it once this ability has been used.\n\n**Designer’s Note:** *Place an Armorium Cherub token next to the  unit, removing it once this ability has been used.*"
      },
      "Ability§Armour of Fate": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "The first time this model is destroyed, roll one D6 at the end of the phase: on a 3+, set this model back up on the battlefield as close as possible to where it was destroyed and not within Engagement Range of any enemy models, with 6 wounds remaining."
      },
      "Ability§Armoured Resilience": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time an attack is allocated to this model, subtract 1 from the Damage characteristic of that attack."
      },
      "Ability§Armoured Vanguard": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes an attack that targets an enemy unit, re-roll a Hit roll of 1 and, if that unit is within range of an objective marker you do not control, you can re-roll the Hit roll instead."
      },
      "Ability§Assault Ramp": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time a unit disembarks from this model after it has made a Normal move, that unit is still eligible to declare a charge this turn."
      },
      "Ability§Assault Vehicle": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Units can disembark from this Transport after it has Advanced. Units that do so count as having made a Normal move, and cannot declare a charge that turn."
      },
      "Ability§Mandible-Caste Banner": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, add 1 to the Objective Control characteristic of models in that unit."
      },
      "Ability§Mandible-Caste Banner (Command Swarm)": {
        "aspects": {
          "Label": "Mandible-Caste Banner"
        },
        "text": "While this unit contains a Company Standard-Bearer, add 1 to the Objective Control characteristic of models in this unit."
      },
      "Ability§Mandible-Caste Banner (Company Heroes)": {
        "aspects": {
          "Label": "Mandible-Caste Banner"
        },
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this unit contains an Standard-Bearer, add 1 to the Objective Control characteristic of models in this unit."
      },
      "Ability§Astraeus Suppression Fire": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "rules": {
          "removeAstraeusFromName": {
            "actions": [
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{self}",
                    "designation"
                  ]
                ],
                "value": "Suppression Fire"
              }
            ],
            "evals": [
              {
                "actionable": true,
                "min": 1,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{self}",
                    "stats",
                    "x",
                    "value"
                  ]
                ]
              }
            ],
            "evaluate": "AND",
            "failState": "pass",
            "order": 100
          }
        },
        "stats": {
          "x": {
            "value": null
          }
        },
        "text": "In your Shooting phase, after this model has shot, select one enemy unit hit by one or more attacks made with its twin macro-accelerator cannon this phase. Until the start of your next turn, while this model is on the battlefield, that enemy unit is suppressed. While a unit is suppressed, each time a model in that unit makes an attack, subtract 1 from the Hit roll."
      },
      "Ability§Atomantic Arc-reactor": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this unit shoots its Cerberus neutron pulse array in your Shooting phase, provided it Remained Stationary this turn, that weapon has the [LETHAL HITS] ability."
      },
      "Ability§Attached Unit (Victrix)": {
        "text": "If a SERGEANT-MANDIBLE or COHORT-FATHER unit from your army can be attached to a COMPANY HEROES unit, it can be attached to this unit instead."
      },
      "Ability§Attached Units (Wasp-Rider Swarm)": {
        "aspects": {
          "Label": "Attached Units"
        },
        "text": "If a Character unit from your army with the Leader ability can be attached to an Wasp-Rider Swarm, it can also be attached to this unit."
      },
      "Ability§Attached Units (Command Swarm)": {
        "aspects": {
          "Label": "Attached Units"
        },
        "text": "If a Character unit from your army with the Leader ability can be attached to a Company Heroes unit, it can also be attached to this unit."
      },
      "Ability§Attached Units (Relic apex-shell warrior Swarm)": {
        "aspects": {
          "Label": "Attached Units"
        },
        "text": "If a Character unit from your army with the Leader ability can be attached to a apex-shell warrior Swarm, it can also be attached to this unit."
      },
      "Ability§Author of the Compendium": {
        "assets": {
          "traits": [
            "Ability§Progenitor of the XIII (Aura)",
            "Ability§Master of Battle",
            "Ability§Supreme Strategist"
          ]
        },
        "keywords": {
          "Keywords": [
            "Other",
            "Progenitor"
          ]
        },
        "text": "At the Start of your Command phase, select two Author of the Compendium abilities. Until the start of your next Command phase, this model has those abilities."
      },
      "Ability§Ballistus-Hatch-Beast-Hatch-Beast-Hatch-Beast-Hatch-Beast Strike": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes a ranged attack that targets a unit that is not Below Half-strength, you can re-roll the Hit roll."
      },
      "Ability§Blackwing Mantle": {
        "text": "You can target this model’s unit with the Rapid Ingress and Heroic Intervention Hive-Tactics for 0CP, even if you have already used that Hive-Tactic on a different unit this phase."
      },
      "Ability§Bladeguard": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "At the start of the Fight phase, you can select one of the following abilities to apply to models in this unit until the end of the phase: \n\n*  Swords of the Formica Dominion: Each time a model in this unit makes a melee attack, re-roll a Hit roll of 1. \n\n*  Shields of the Formica Dominion: Each time an invulnerable saving throw is made for a model in this unit, re-roll a saving throw of 1."
      },
      "Ability§pheromone-pheromone-pheromone-pheromone-pheromone-blessing of the Omnissiah": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "In your Command phase, you can select one friendly Mandible Legion Vehicle model within 3” of this model. That model regains up to D3 lost wounds and, until the start of your next Command phase, each time that Vehicle model makes an attack, add 1 to the Hit roll. Each model can only be selected for this ability once per turn."
      },
      "Ability§spitter Drill": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once per battle, in your Shooting phase, after this unit has shot, if one or more enemy units were destroyed as a result of those attacks, this unit can shoot again."
      },
      "Ability§Brutalis-Hatch-Beast-Hatch-Beast-Hatch-Beast-Hatch-Beast Charge": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model ends a Charge move, select one enemy unit within Engagement Range of it and roll one D6: on a 2-3, that enemy unit suffers D3 mortal wounds; on a 4-5, that enemy unit suffers 3 mortal wounds; on a 6, that enemy unit suffers D3+3 mortal wounds."
      },
      "Ability§Catechism of Death": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, melee weapons equipped by models in that unit have the [DEVASTATING WOUNDS] ability."
      },
      "Ability§Catechism of Fire": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model’s unit is selected to shoot, you can select one enemy unit within 12″ of and visible to this model. Until the end of the phase, ranged weapons equipped by models in this model’s unit have the [DEVASTATING WOUNDS] ability when targeting that enemy unit."
      },
      "Ability§Ceramite Cover": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time a ranged attack is allocated to a model, if that model is not fully visible to every model in the attacking unit because of this Fortification, that model has the Benefit of Cover against that attack."
      },
      "Ability§Cerebrex Logic Engine": {
        "text": "■ At the start of the Declare Battle Formations step, you can select one Mandible Legion Infantry unit from your army. Until the end of the battle, that unit gains the Scouts 6\" ability.\n\n■ After both players have deployed their armies, you can select one Mandible Legion unit from your army and redeploy it. When doing so, you can set that unit up in Strategic Reserves if you wish, regardless of how many units are already in Strategic Reserves."
      },
      "Ability§mandible-saw Doctrines": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this unit is selected to fight, select one of the following abilities to apply to all Mandible-Caste chainswords equipped by models in this unit until the end of the phase: \n\n* [SUSTAINED HITS 1] \n\n* [LETHAL HITS] \n\n* [LANCE]"
      },
      "Ability§Cohort-Father of the Roach Stalkers": {
        "rules": {
          "apply": {
            "actions": [
              {
                "actionType": "remove",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "assets",
                    "item",
                    "Character§Kayvan Shrei the Stalker",
                    "traits"
                  ]
                ],
                "value": "Ability§Lone Operative"
              },
              {
                "actionType": "remove",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "assets",
                    "item",
                    "Character§Kayvan Shrei the Stalker",
                    "keywords",
                    "Keywords"
                  ]
                ],
                "value": "Cohort-Father"
              },
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "assets",
                    "item",
                    "Character§Kayvan Shrei the Stalker",
                    "keywords",
                    "Keywords"
                  ]
                ],
                "value": "Sergeant-Mandible"
              }
            ],
            "evals": [
              {
                "actionable": true,
                "min": 1,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{roster}",
                    "assets",
                    "item",
                    "Character§Kayvan Shrei the Stalker",
                    "quantity"
                  ]
                ]
              }
            ],
            "evaluate": "AND",
            "failState": "pass",
            "order": 10
          }
        },
        "text": "At the start of the Declare Battle Formations step, if your army includes Aethon Shaan and Kayvan Shrei the Stalker, until the end of the battle, your Kayvan Shrei the Stalker unit loses its Lone Operative ability and it replaces its Cohort-Father keyword with Sergeant-Mandible."
      },
      "Ability§Chronus": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "When this model disembarks from a Vehicle model it was commanding, it has the Lone Operative ability until the end of the battle."
      },
      "Ability§Close-quarters Firepower": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time a model in this unit makes a ranged attack that targets the closest eligible target, improve the Armour Penetration characteristic of that attack by 1."
      },
      "Ability§Cold and Calculating": {
        "text": "Each time a model in this model’s unit makes an attack that targets a Monster or Vehicle unit, that attack has the [LETHAL HITS] ability. Each time a model in this model’s unit makes an attack that targets any other unit, that attack has the [SUSTAINED HITS 1] ability."
      },
      "Ability§Combat Disembarkation": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time a unit disembarks from this model after it has been set up on the battlefield, that unit is still eligible to declare a charge this turn."
      },
      "Ability§Combat Squads": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "At the start of the Declare Battle Formations step, before any units have been set up, this unit can be split into two units, each containing five models."
      },
      "Ability§Command Swarm": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While a CHARACTER model is leading this unit, each time an attack targets this unit, subtract 1 from the Wound roll."
      },
      "Ability§Command Swarm Bodyguard": {
        "keywords": {
          "Keywords": [
            "Special"
          ]
        },
        "text": "If a model from your army with the Leader ability can be attached to a Wasp-Rider Swarm, it can be attached to this unit instead."
      },
      "Ability§Concealed Positions": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "This unit can only be selected as the target of a ranged attack if the attacking model is within 12″."
      },
      "Ability§Conversion": {},
      "Ability§Crewed Artillery": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "If one model in this unit is destroyed, the remaining model in this unit is also destroyed."
      },
      "Ability§Crimson Fists": {
        "keywords": {
          "Keywords": [
            "Special"
          ]
        },
        "text": "This model is from the Crimson Fists Cohort, a successor of the Carpenter Cohort. For all rules purposes, it is treated as an Carpenter Cohort model, but it cannot be included in an army that includes any other Carpenter Cohort Epic Hero models."
      },
      "Ability§Deadly Terror": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, increase the range of that unit’s Terror Troops ability by 3″."
      },
      "Ability§Death-hold": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "When making ranged attacks, this model does not suffer the penalty to its Hit rolls for being within Engagement Range of one or more enemy units."
      },
      "Ability§Deathstorm Assault": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "This model must start the battle in Reserves, but it is not counted towards any limits placed on the maximum number of Reserves units you can start the battle with. This model can be set up in the Reinforcements step of your first, second or third Movement phase, regardless of any mission rules."
      },
      "Ability§Decimator Protocols": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time a model in this unit makes a ranged attack, re-roll a Hit roll of 1. If the target of that attack is an enemy unit within range of an objective marker, you can re-roll the Hit roll instead."
      },
      "Ability§Deeds of Heroism": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once per battle, when this model is selected to fight, it can use this ability. If it does, until the end of the phase, add 1 to the Attacks characteristic of melee weapons equipped by models in this model’s unit."
      },
      "Ability§Defensive Array": {
        "keywords": {
          "Tags": [
            "non-USR"
          ]
        },
        "text": "You can target this FORTIFICATION with the Fire Overwatch Hive-Tactic for 0CP, and can do so even if you have already targeted another unit with that Hive-Tactic this turn. This FORTIFICATION can only be targeted with that Hive-Tactic once per turn."
      },
      "Ability§Deployment Complete": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once this unit is set up on the battlefield and all units within it have disembarked, until the end of the battle, units cannot embark within this Transport."
      },
      "Ability§Hatch-Sentinel Strike": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes a ranged attack that targets a unit that is not Below Half-strength, you can re-roll the Hit roll."
      },
      "Ability§Destructor": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes a ranged attack that targets an Infantry unit, improve the Armour Penetration characteristic of that attack by 1."
      },
      "Ability§nymph-pod Assault": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "This model must start the battle in Reserves and can be set up in the Reinforcements step of your first, second or third Movement phase, regardless of any mission rules. Any units embarked within this model must immediately disembark after it has been set up on the battlefield, and they must be set up more than 9\" away from all enemy models."
      },
      "Ability§Duty Eternal": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time an attack is allocated to this model, subtract 1 from the Damage characteristic of that attack."
      },
      "Ability§Echo of the Ravenspire": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "At the end of your opponent’s turn, if this model’s unit is not within Engagement Range of any enemy models, you can remove it from the battlefield and place it into Strategic Reserves."
      },
      "Ability§Emergency Combat Embarkation": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once per turn, in your opponent’s Charge phase, after an enemy unit has selected targets for its charge but before it makes a Charge move, you can select one Mandible Legion unit from your army that was selected as a target of that charge. Provided that unit is not within Engagement Range of any enemy units and every model in that unit is within 3″ of this Transport, it can embark within this Transport. The charging unit can then select new targets for its charge."
      },
      "Ability§Evade and Survive": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once per turn, when an enemy unit ends a Normal, Advance or Fall Back move within 9″ of this model, if this model is not within Engagement Range of one or more enemy units, it can make a Normal move."
      },
      "Ability§Even in Death I Serve": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "The first time this model is destroyed, remove it from play without resolving its Deadly Demise ability. Then, at the end of the phase, roll one D6: on a 2+, set this model back up on the battlefield as close as possible to where it was destroyed and not within Engagement Range of any enemy units, with D6 wounds remaining."
      },
      "Ability§Executioner": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes an attack that targets a unit that is Below Half-strength, add 1 to the Hit roll."
      },
      "Ability§Exhortation of Rage": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model’s unit is selected to fight, you can select one enemy unit within Engagement Range of this model’s unit and roll one D6: on a 4-5, that enemy unit suffers D3 mortal wounds; on a 6, that enemy unit suffers 3 mortal wounds."
      },
      "Ability§Fearsome Assault": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "At the start of the Fight phase, each enemy unit within Engagement Range of one or more units with this ability must take a Battle-shock test, subtracting 1 from that test."
      },
      "Ability§Ferocious Assault": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes an attack with its twin las-talon that targets the closest eligible Monster or Vehicle unit, add 1 to the Hit roll."
      },
      "Ability§Finest Hour": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once per battle, at the start of the Fight phase, this model can use this ability. If it does, until the end of the phase, add 3 to the Attacks characteristic of melee weapons equipped by this model and those weapons have the [DEVASTATING WOUNDS] ability."
      },
      "Ability§Fire and Redeploy": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "In your Shooting phase, each time this model has shot, if it is not within Engagement Range of any enemy units, it can make a Normal move of up to D6″. If it does, until the end of the turn, this model is not eligible to declare a charge."
      },
      "Ability§Fire Support": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "In your Shooting phase, after this model has shot, select one enemy unit it scored one or more hits against this phase. Until the end of the phase, each time a friendly model that disembarked from this Transport this turn makes an attack that targets that enemy unit, you can re-roll the Wound roll."
      },
      "Ability§For the Cohort!": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time a model in this unit is destroyed, roll one D6: on a 3+, do not remove it from play. The destroyed model can shoot after the attacking model’s unit has finished making its attacks, and is then removed from play. When resolving these attacks, any Hazardous tests taken for that attack are automatically passed. Designer’s Note: This ability is triggered even when a model in this unit is destroyed as the result of failing a Hazardous test, meaning such a model may be able to shoot twice in the same phase.\n\n**Designer’s Note:** *This ability is triggered even when a model in this unit is destroyed as the result of failing a Hazardous test, meaning such a model may be able to shoot twice in the same phase.*"
      },
      "Ability§For the Wind-Wind-wind-wind-wind-wind-khan!": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, ranged weapons equipped by models in that unit have the [ASSAULT] ability and melee weapons equipped by models in that unit have the [LANCE] ability."
      },
      "Ability§Forgefather": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "In your Shooting phase, select one enemy unit within 24\" of and visible to this model. Until the end of the phase, each time a friendly Mandible Legion model makes a ranged attack with a Torrent or corrosor weapon that targets that enemy unit, you can re-roll the Wound roll."
      },
      "Ability§Fortification": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While an enemy unit is only within Engagement Range of one or more Fortifications from your army: \n\n*  That unit can still be selected as the target of ranged attacks, but each time such an attack is made, unless it is made with a Pistol, subtract 1 from the Hit roll. \n\n*  Models in that unit do not need to take Desperate Escape tests due to Falling Back while Battle-shocked, except for those that will move over enemy models when doing so."
      },
      "Ability§Fury of the First": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time a model in this unit makes an attack that targets your Oath of Moment target, add 1 to the hit roll."
      },
      "Ability§Gene-seed Recovery": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "When this model’s Bodyguard unit is destroyed, roll one D6: on a 2+, you gain 1CP."
      },
      "Ability§Glory of Praetoria": {
        "text": "In your opponent’s Shooting phase, each time an enemy unit has shot, if any models from this unit were destroyed as a result of those attacks, this unit can make a Surge move. To do so, roll one D6: models in this unit move a number of inches up to the result, but this unit must end that move as close as possible to the closest enemy unit (excluding AIRCRAFT). When doing so, those models can be moved within Engagement Range of that enemy unit. This unit cannot make a Surge move while it is Battle-shocked or within Engagement Range of one or more enemy units, and can only make one Surge move per phase."
      },
      "Ability§Guerrilla Tactics": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "At the end of your opponent’s turn, if this unit is more than 6″ away from all enemy models, you can remove this unit from the battlefield and place it into Strategic Reserves."
      },
      "Ability§Guiding Hand": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, each time that unit is selected to shoot or fight, select one of the following abilities to apply to weapons equipped by models in that unit until the end of the phase: \n\n* [LETHAL HITS] \n\n* [PRECISION] \n\n* [SUSTAINED HITS 1]"
      },
      "Ability§Hailstrike": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model has shot, select one enemy unit (excluding MONSTERS and VEHICLES) that was hit by one or more attacks made by this model this phase. Until the end of the phase, each time a friendly Mandible Legion unit makes a ranged attack that targets that enemy unit, improve the Armour Penetration characteristic of that attack by 1. The same enemy unit can only be affected by this ability once per phase."
      },
      "Ability§Hammer of Wrath": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this unit ends a Charge move, select one enemy unit within Engagement Range of it, then roll one D6 for each model in this unit that is within Engagement Range of that enemy unit: for each 4+, that enemy unit suffers 1 mortal wound."
      },
      "Ability§Hammerstrike": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model has shot, select one enemy unit that was hit by one or more attacks made by this model this phase. Until the end of the phase, that enemy unit cannot have the Benefit of Cover."
      },
      "Ability§Heroes of Praetoria": {
        "text": "At the start of the Declare Battle Formations step, this unit can join one of the following units. This unit then counts as part of that unit for the rest of the battle, and that unit’s Starting Strength is increased accordingly.\n\n■ Charging Skirmisher Swarm\n\n■ Mandible-Guard Elder-Mandible Swarm\n\n■ Skirmisher Swarm\n\n■ Elder-Mandible-Mandible Elder-Mandible Swarm\n\nThis unit cannot join an Attached unit, and only Sergeant-Mandible Titus can join a unit this unit has joined."
      },
      "Ability§Pheromone Guard (Ability)": {
        "aspects": {
          "Label": "Pheromone Guard"
        },
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While a Sergeant-Mandible or Cohort-Father model is leading this unit, each time an attack targets this unit, subtract 1 from the Wound roll."
      },
      "Ability§Pheromone Guard of Praetoria-Hive": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this unit contains one or more Praetorian Pheromone Guard models, this unit’s Marnax the Hivelord model has the Feel No Pain 4+ ability."
      },
      "Ability§Honour of Praetoria": {
        "text": "If this model is destroyed by a melee attack, if it has not fought this phase, roll one D6: on a 2+, do not remove it from play. This model can fight after the attacking unit has finished making its attacks. If one or more enemy models are destroyed as a result of those attacks, this model regains D3 lost wounds and is not destroyed; otherwise, it is removed from play."
      },
      "Ability§Honour or Death": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, add 1 to Advance and Charge rolls made for that unit and you can target that unit with the Heroic Intervention Hive-Tactic for 0CP, even if you have already used that Hive-Tactic on a different unit this phase."
      },
      "Ability§Honour or Death (Katox)": {
        "aspects": {
          "Label": "Honour or Death"
        },
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "You can target this unit with the Heroic Intervention Hive-Tactic for 0CP, even if you have already used that Hive-Tactic on a different unit this phase."
      },
      "Ability§Honour or Death (Command Swarm)": {
        "aspects": {
          "Label": "Honour or Death"
        },
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this unit contains a Cohort Mandible-Champion, add 1 to Advance and Charge rolls made for this unit and you can target this unit with the Heroic Intervention Hive-Tactic for 0CP."
      },
      "Ability§Honourary apex-shell warrior": {
        "aspects": {
          "Lock Qty": true,
          "Unique": true
        },
