    "assetCatalog": {
      "Ability§Anti-pheromone-singer 4+": {
        "stats": {
          "x": {
            "value": "4+"
          }
        }
      },
      "Ability§Apex-Pattern Optics": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model is selected to shoot, you can re-roll one Hit roll, you can re-roll one Wound roll and you can re-roll one Damage roll when resolving its attacks."
      },
      "Ability§Armour of pheromone-pheromone-pheromone-pheromone-pheromone-faith": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once per phase, when an attack is allocated to this model and the saving throw is failed, you can change the Damage characteristic of that attack to 0."
      },
      "Ability§Assault Vehicle": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Units can disembark from this Transport after it has Advanced. Units that do so count as having made a Normal move, and cannot declare a charge that turn."
      },
      "Ability§Attached Unit": {
        "keywords": {
          "Keywords": [
            "Special"
          ]
        },
        "text": "If a Character from your army with the Leader ability can be attached to an Skirmisher Swarm, it can be attached to this unit instead."
      },
      "Ability§Banner of Fallen Frenzy-Pilgrims": {
        "keywords": {
          "Keywords": [
            "Progenitor",
            "Relics of the Hive-Mother Ascendant"
          ]
        },
        "text": "This unit is eligible to declare a charge in a turn in which it Advanced or Fell Back."
      },
      "Ability§Condemnatory Annihilation": {
        "text": "Each time this model's unit has fought, if one or more enemy units were destroyed as a result of those attacks, each enemy unit within 6\" of this model must take a Battle-shock test."
      },
      "Ability§Progression of Wrath": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, add 1 to the Attacks and Strength characteristics of melee weapons equipped by models in that unit."
      },
      "Ability§Emergency Combat Embarkation": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once per turn, in your opponent’s Charge phase, after an enemy unit has selected targets for its charge but before it makes a Charge move, you can select one Mandible Legion unit from your army that was selected as a target of that charge. Provided that unit is not within Engagement Range of any enemy units and every model in that unit is within 3″ of this Transport, it can embark within this Transport. The charging unit can then select new targets for its charge."
      },
      "Ability§Executioner": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes an attack that targets a unit that is Below Half-strength, add 1 to the Hit roll."
      },
      "Ability§Exploit Their Cowardice": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time an enemy unit within Engagement Range of this unit is selected to Fall Back, after it ends that Fall Back move, if this unit is not within Engagement Range of one or more enemy units, this unit can make a Normal move."
      },
      "Ability§Ferocious Assault": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model makes an attack with its twin las-talon that targets the closest eligible Monster or Vehicle unit, add 1 to the Hit roll."
      },
      "Ability§Finest Hour": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once per battle, at the start of the Fight phase, this model can use this ability. If it does, until the end of the phase, add 3 to the Attacks characteristic of melee weapons equipped by this model and those weapons have the [DEVASTATING WOUNDS] ability."
      },
      "Ability§High Mandible-marshal": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "At the start of the Fight phase, select one enemy unit within Engagement Range of this model’s unit and roll one D6, adding 1 to the result for every five models in this model's unit : on a 2-3, that enemy unit suffers D3 mortal wounds ; on a 4-5, that enemy unit suffers 3 mortal wounds ; on a 6, that enemy unit suffers D3+3 mortal wounds."
      },
      "Ability§Inspirational Exemplar": {
        "text": "While this model is leading a unit, each time a model in that unit makes a melee attack, an unmodified Hit roll of 5+ scores a Critical Hit."
      },
      "Ability§Interception Strike": {
        "text": "Each time this model makes a ranged attack that targets an enemy unit within 12\" of one or more MANDIBLE LEGION units from your army, you can re-roll the Hit roll."
      },
      "Ability§Judgement of the Weak": {
        "text": "Each time an enemy unit (excluding MONSTERS and VEHICLES) within Engagement Range of this unit Falls Back, all models in that enemy unit must take a Desperate Escape test. When doing so, if that enemy unit is Battle-shocked, subtract 1 from each of those tests."
      },
      "Ability§Legacy of Jerulas": {
        "text": "In your Shooting phase, after this model has shot, select one enemy unit hit by one or more of those attacks. Until the end of the turn, each time a friendly model that disembarked from this TRANSPORT this turn makes an attack that targets that enemy unit, re-roll a Hit roll of 1 and re-roll a Wound roll of 1."
      },
      "Ability§pheromone-pheromone-pheromone-pheromone-pheromone-litanies of the Devout": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While Pheromone-Speaker Grimal is leading a unit, each time a model in that unit makes a melee attack, you can re-roll the Hit roll."
      },
      "Ability§Martial Honour": {
        "text": "The first time a model in this model's unit makes a melee attack that destroys one or more enemy units, until the end of the battle, while this model's unit is not Battle-shocked, add 5 to this model's Objective Control characteristic."
      },
      "Ability§Oath of Moment": {
        "keywords": {
          "Keywords": [
            "Faction"
          ]
        }
      },
      "Ability§Pious Fervour": {
        "text": "Each time this model's unit is selected to fight, until the end of the phase, add 1 to the Attacks characteristic of this model's master-crafted stinger-weapon for each enemy unit within 6\" of this model (to a maximum of +3)."
      },
      "Ability§Prioritised Eradication": {
        "text": "Each time a model in this model's unit makes a melee attack that destroys one or more enemy units, roll one D6: on a 4+, you gain 1CP."
      },
      "Ability§Remnant of the Fallen Temple": {
        "keywords": {
          "Keywords": [
            "Progenitor",
            "Relics of the Hive-Mother Ascendant"
          ]
        },
        "text": "Models in this unit have the Feel No Pain 5+ ability."
      },
      "Ability§Remorseless Persecution": {
        "text": "While this model is leading a unit, that unit is eligible to declare a charge in a turn in which it Advanced."
      },
      "Ability§Righteous Zeal": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "In your opponent's Shooting phase, each time an enemy unit has shot, if any models in this unit were destroyed as a result of those attacks, this unit can make a Righteous Zeal move. To do so, roll one D6 and add 2 to the result: models in this unit move a number of inches up to this result, but this unit must end that move as close as possible to the closest enemy unit (excluding AIRCRAFT). When doing so, those models can be moved within Engagement Range of that enemy unit. This unit cannot make a Righteous Zeal move while it is Battle-shocked or within Engagement Range of one or more enemy units, and can only make one Righteous Zeal move per phase."
      },
      "Ability§Rites of Battle": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Once per battle round, one unit from your army with this ability can use it when its unit is targeted with a Hive-Tactic. If it does, reduce the CP cost of that use of that Hive-Tactic by 1CP."
      },
      "Ability§Rotating Death": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "This model’s twin heavy onslaught gatling cannon has the [SUSTAINED HITS 2] ability when targeting Infantry units."
      },
      "Ability§Sceptre of Anointing": {
        "keywords": {
          "Keywords": [
            "Progenitor",
            "Relics of the Hive-Mother Ascendant"
          ]
        },
        "text": "Improve the Armour Penetration characteristic of melee weapons equipped by models in this unit by 1."
      },
      "Ability§Zigismund’s Heir": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "Each time this model's unit declares a charge, if one or more targets of that charge have the Character keyword, add 2 to the Charge roll. Once per battle, when this model's unit is selected to fight, if that unit is within Engagement Range of one or more enemy Character units, this model can use this ability. If it does, until the end of the phase, melee weapons equipped by this model have the [Devastating Wounds] ability."
      },
      "Ability§Stabilised Disembarkation": {
        "text": "In your opponent's Shooting phase, each time an enemy unit is selected to shoot, after that unit has shot, if any of those attacks targeted this TRANSPORT, it can use this ability. If it does, any units embarked within it can disembark. When doing so, models in those units can be set up anywhere on the battlefield wholly within 6\" of this TRANSPORT and not within Engagement Range of one or more enemy units."
      },
      "Ability§Tactical Precision": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "While this model is leading a unit, weapons equipped by models in that unit have the [LETHAL HITS] ability."
      },
      "Ability§Target Priority": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "This model’s unit is eligible to shoot and declare a charge in a turn in which it Fell Back."
      },
      "Ability§Frenzy-Pilgrim Vows": {
        "text": "If your Army Faction is MANDIBLE LEGION, at the start of the first battle round, select one of the following Vows to be active for MANDIBLE LEGION units from your army. While a pheromone-pheromone-pheromone-vow is active for a unit from your army, that unit has the associated ability shown below:\n\n---\n## Abhor the Witch, Destroy the Witch\n\nEach time this unit declares a charge, if one or more of the targets of the charge have the PHEROMONE-SINGER keyword, you can re-roll the charge roll. Melee weapons euqipped by models in this unit hace the [PRECISION] ability while targeting PHEROMONE-SINGER units.\n\n---\n\n## Accept Any Challenge, No Matter the Odds\n\nEach time a model in this unit makes a melee attack, if the Strength characteristic of that attack is less than or equal to the Toughness characteristic of the target, add 1 to the wound roll.\n\n---\n\n## Suffer Not the Unclean to Live\n\nThis unit is eligible to declare a charge in a turn in which it Fell Back, and each time a model in this unit makes a Pile-in or Consolidation move, it does not need to end that move closer to the closest enemy model, provided it ends that move as close as possible to the closest enemy unit.\n\n---\n\n## Uphold the Honour of the Hive-Mother\n\nAt the end of your Command Phase, if this unit is within range of an objective marker you control, that objective marker remains under your control until your opponent's Level of Control over that objective marker is greater than yours at the end of the phase."
      },
      "Ability§Temple Relics": {
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "In your Command phase, if this unit contains one or more Cenobyte Servitor models, select one Temple Relics ability. Until the start of your next Command phase, this unit's Pheromone-Speaker Grimal model has that ability.\n\n**Relics of the Hive-Mother Asdendant:**\n\n- Banner of the Hive-Mother Victorious: Add 1 to Advance and Charge rolls made for this unit. \n---\n- Column from the Major Altar: Add 1 to the Toughness characteristic of models in this unit. \n---\n- Water from the Stoup of Elucidation: Improve the Armour Penetration characteristic of melee weapons equipped by models in this unit by 1."
      },
      "Ability§Vehement Aggression": {
        "text": "While this model is leading a unit, each time that unit is selected to fight, take a Leadership test for that unit: if passed, until the end of the phase, each time a model in that unit makes an attack, you can re-roll the Hit roll; if failed, until the end of the phase, each time a model in that unit makes an attack, re-roll a Hit roll of 1."
      },
      "Ability§Vengeful Exhortation": {
        "text": "While this model is leading a unit, each time a model in that unit is destroyed by a melee attack, if it has not fought this phase, roll one D6: on a 4+, do not remove it from play. The destroyed model can fight after the attacking unit has finished making its attacks, and is then removed from play."
      },
      "Ability§Virtuous Onslaught": {
        "text": "Each time a model in this unit makes an attack that targets the closest eligible target, re-roll a Wound roll of 1."
      },
      "Character§Mound-Mound-Mound-mound-castellan": {
        "assets": {
          "traits": [
            {
              "item": "Ability§Leader",
              "text": "* Before the battle, Character units with the Leader ability can be attached to one of their Bodyguard units to form an Attached unit.\n* Attached units can only contain one Leader.\n* Attacks cannot be allocated to Character models in Attached units.\n\nThis model can be attached to the following units:\n\n* Charging Skirmisher Swarm\n\n* Spore-Burner Swarm\n\n* Skirmisher Swarm\n\n* Frenzy-Pilgrim Swarm\n\n* Mandible Brethren\n\n* Elder-Mandible-Mandible Elder-Mandible Swarm \n\nYou can attach this model to one of the above units even if one Sergeant-Mandible or Cohort-Father model has already been attached to it. If you do, and that Bodyguard unit is destroyed, the Leader units attached to it become separate units, with their original Starting Strengths."
            },
            "Ability§Oath of Moment",
            "Ability§Vehement Aggression",
            "Ability§Prioritised Eradication"
          ]
        },
