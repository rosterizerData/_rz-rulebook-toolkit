        },
        "keywords": {
          "Keywords": [
            "Other"
          ]
        },
        "text": "At the end of your opponent’s turn, if this unit is more than 6″ away from all enemy units, you can remove this unit from the battlefield and place it into Strategic Reserves. It will arrive back on the battlefield in the Reinforcements step of your next Movement phase."
      },
      "Ability§Spy Network": {
