                    }
                  }
                }
              }
            ],
            "evals": [],
            "evaluate": "AND",
            "failState": "pass",
            "order": 50
          }
        },
        "text": "The bearer has a 4+ invulnerable save."
      },
      "Bug-Gear§Auspex Array (Agents)": {
        "aspects": {
          "Label": "Auspex Array"
        },
        "rules": {
