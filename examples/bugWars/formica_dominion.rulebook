      "Character§Hive-Cantor (Agents)": {
        "assets": {
          "traits": [
            {
              "item": "Ability§Leader",
              "text": "This model can be attached to the following units:\n\n* Inquisitorial Agents\n\n* formica Navy Breachers\n\n* Subductor Swarm\n\n* Exaction Swarm\n\n* Vigilant Swarm\n\n* Sisters of the Frenzy Swarm\n\nYou can attach this model to an Inquisitorial Agents unit, even if one magister has already been attached to it. If you do, and that Bodyguard unit is destroyed, the Leader units attached to it become separate units, with their original Starting Strengths."
            },
            "Ability§Assigned Agents",
            {
              "item": "Ability§Invulnerable",
              "stats": {
                "x": {
                  "value": "4+"
                }
              }
            },
            "Ability§Holy Hatred",
            "Ability§Zealot"
