        "rules": {
          "beverly": {
            "actions": [
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{self}",
                    "constraints",
                    "any"
                  ]
                ],
                "value": "Built"
              },
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{self}",
                    "constraints",
                    "any"
                  ]
                ],
                "value": "Horror"
              }
            ],
            "evals": [
              {
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{roster}",
                    "stats",
                    "Sponsor",
                    "value"
                  ]
                ],
                "value": "Tachyon, the Phantom of the Strip"
              }
            ],
            "evaluate": "OR",
            "failState": "pass",
            "order": 2
          },
