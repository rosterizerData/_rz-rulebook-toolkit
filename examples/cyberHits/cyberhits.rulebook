      "Special Rule§Full-Sweep": {
        "keywords": {
          "Tags": [
            "Weapon Rule"
          ]
        },
        "text": "This weapon has a 360° arc of plasma-fire."
      },
      "Special Rule§Airborne": {
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "text": "This Vehicle ignores obstructions, dropped weapons and terrain at all times; except that this vehicle may target other vehicles in its attack step. Other vehicles ignore this vehicle at all times, except that other vehicles may target this vehicle during their attack steps. This vehicle cannot be involved in collisions."
      },
      "Special Rule§Stealth-Rotor": {
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "text": "At the start of this vehicle’s activation, this vehicle may make a single pivot about its centre point, up to 90 degrees."
      },
      "Special Rule§All-Terrain": {
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "text": "This vehicle may ignore the penalties for rough and treacherous surfaces."
      },
      "Special Rule§Articulated": {
        "allowed": {
          "classifications": [
            "Weapon—Mounted",
            "Weapon—Dropped"
          ]
        },
        "constraints": {
          "none": [
            "Krall Industrial"
          ]
        },
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "text": "An articulated vehicle is comprised of two parts: the cab and the trailer. See Convoy Rig rules for details."
      },
      "Special Rule§Blast": {
        "keywords": {
          "Tags": [
            "Weapon Rule"
          ]
        },
        "text": "For every un-canceled hit, the target immediately gains one strain marker."
      },
      "Special Rule§Blitz": {
        "keywords": {
          "Tags": [
            "Weapon Rule"
          ]
        },
        "text": "During its attack step, this weapon’s vehicle may attack any number of times, up to its remaining ammo or crew stat, whichever is lesser."
      },
      "Special Rule§Drop-Strike": {
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "rules": {
          "bombsAway": {
            "actions": [
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{parent}",
                    "included",
                    "classification",
                    "Weapon—Dropped",
                    "stats",
                    "Cost",
                    "value"
                  ]
                ],
                "value": 0
              }
            ],
            "evals": [],
            "evaluate": "OR",
            "failState": "pass"
          }
        },
        "text": "When purchasing weapons, this vehicle may count dropped weapons as requiring 0 loadout slots."
      },
      "Special Rule§Operator-Fired": {
        "keywords": {
          "Tags": [
            "Weapon Rule"
          ]
        },
        "text": "360° arc of plasma-fire."
      },
      "Special Rule§Sedative": {
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "text": "When this vehicle declares a SMASH ATTACK during its activation remove 2 strain markers from the target vehicle, and then reduce the target vehicle’s crew value by 1 until the end of the phase."
      },
      "Special Rule§Electrical": {
        "keywords": {
          "Tags": [
            "Weapon Rule"
          ]
        },
        "text": "The book doesn’t seem to say anything about this."
      },
      "Special Rule§Plasma-Burn": {
        "keywords": {
          "Tags": [
            "Weapon Rule"
          ]
        },
        "text": "If this weapon deals at least one damage to a target that isn’t *On Plasma-Fire*, that target is set On Plasma-Fire."
      },
      "Special Rule§Full Throttle": {
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "text": "This vehicle considers the long straight maneuver template to be permitted in any gear. The long straight is not considered either hazardous or trivial in any gear."
      },
      "Special Rule§Indirect": {
        "keywords": {
          "Tags": [
            "Weapon Rule"
          ]
        },
        "text": "When making a shooting attack, this weapon’s vehicle may ignore Terrain and Cover during that attack."
      },
      "Special Rule§Subliminal Jingle": {
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "text": "Vehicles that target this vehicle with a SMASH ATTACK during a collision receive no strain markers during step 6 of the collision resolution."
      },
      "Special Rule§Turbine Engine": {
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "text": "A vehicle with a jet engine counts as having a NOS Booster with infinite ammo cells. This vehicle automatically explodes when it is totaled. A vehicle with a jet engine must use the NOS Booster every time it activates."
      },
      "Special Rule§Bulldozer": {
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "text": "During this vehicle’s Movement Step, when the vehicle collides with another vehicle of a lighter weight-class, it may declare a Bulldozer Ram Attack as its reaction. See Convoy Rig rules."
      },
      "Special Rule§Pivot": {
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "text": "At the start of this vehicle’s activation, if  this vehicle’s current Gear is 1, this vehicle may make a pivot about its centre to face any direction. This pivot cannot cause a Collision and cannot leave this vehicle touching an obstruction."
      },
      "Special Rule§Sluggish": {
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "text": "Hard to maneuver but also hard to throttle. See Convoy Rig rules."
      },
      "Special Rule§Restricted": {
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "text": "If playing with Sponsor rules, this vehicle can only be purchased by a squad with the appropriate sponsor."
      },
      "Special Rule§Slip Away": {
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "text": "If this vehicle is targeted with a tailgate, T-bone or sideswipe ram attack, and this vehicle declares evade as its reaction, this vehicle may perform a free activation immediately after the active vehicle completes its activation. This free activation does not count as the vehicle’s activation this gear phase."
      },
      "Special Rule§Tight Burst": {},
      "Special Rule§Splash": {
        "keywords": {
          "Tags": [
            "Weapon Rule"
          ]
        },
        "text": "When this weapon is used to attack, resolve a separate attack targeting each vehicle, including allies, under its shooting template."
      },
      "Special Rule§Turret": {
        "allowed": {
          "classifications": [
            "Weapon—Mounted"
          ]
        },
        "constraints": {
          "none": [
            "Krall Industrial"
          ]
        },
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "rules": {
          "Only 1 weapon can mount on this turret": {
            "actions": [
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{self}",
                    "assets",
                    "classification",
                    [
                      "Weapon—Mounted",
                      "Weapon—Restricted"
                    ],
                    "stats",
                    "Mounting",
                    "value"
                  ]
                ],
                "value": "360°"
              },
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{self}",
                    "assets",
                    "classification",
                    [
                      "Weapon—Mounted",
                      "Weapon—Restricted"
                    ],
                    "stats",
                    [
                      "Cost",
                      "Mounting"
                    ],
                    "dynamic"
                  ]
                ],
                "value": false
              }
            ],
            "evals": [
              {
                "min": 2,
                "not": true,
                "operator": "SUM",
                "paths": [
                  [
                    "{self}",
                    "tally",
                    [
                      "Weapon—Mounted",
                      "Weapon—Restricted"
                    ]
                  ]
                ]
              }
            ],
            "evaluate": "OR",
            "failState": "error",
            "order": 23
          }
        },
        "text": "This vehicle may count one weapon as turret-mounted without paying for the upgrade."
      },
      "Special Rule§Run-Over": {
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "text": "After resolving a collision with an obstruction of a lower weight class during movement step 1.7, this vehicle may declare a Up and Over to ignore the obstruction for the remainder of its movement step, as it drives right over the top of it. This vehicle cannot declare a Up and Over against another vehicle with the Up and Over special rule."
      },
      "Special Rule§Stim-Boost": {
        "keywords": {
          "Tags": [
            "Vehicle Rule"
          ]
        },
        "text": "If this vehicle is involved in a collision in which both vehicles declare an evade, both vehicles must declare a single stick-throttle up immediately after the collision is resolved (gaining a strain marker as per the normal stick-throttle rules). If either vehicle is already at its max gear, the stick-throttle does not affect that vehicle’s current gear, but that vehicle does gain a strain marker."
      },
      "Sponsor Perk§All the Toys": {
        "text": "Whenever a vehicle in this squad attacks with a named weapon that has not been attacked with by any vehicle during this game yet this squad gains +1 stream credit."
      },
      "Sponsor Perk§Straight Shooter": {
        "text": "This vehicle does not gain a strain from the articulated rule if it selects a template that is not a straight."
      },
      "Sponsor Perk§At the Crossroads": {
        "text": "This squad may choose to pay only 1 vote to redeploy a vehicle. If they do, the respawned car must gain the *Ghost Rider* special rule."
      },
      "Sponsor Perk§Bogey at 12 O'Clock": {
        "text": "At the end of this vehicle’s movement step, if the Bogey is in this vehicle’s front arc of plasma-fire, in line of sight, and further than double range away, this vehicle may immediately resolve another movement step."
      },
      "Sponsor Perk§Plasma-Burned Man": {
        "text": "If this vehicle is On Plasma-Fire it gains +1 to all evade dice."
      },
      "Sponsor Perk§Crew Quarters": {
        "rules": {
          "halfCostCrew": {
            "actions": [
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "assets",
                    "classification",
                    "Vehicle",
                    "assets",
                    "item",
                    "Upgrade§Extra Operator",
                    "stats",
                    "Cost",
                    "value"
                  ]
                ],
                "value": 2
              }
            ],
            "evaluate": "AND",
            "failState": "pass"
          }
        },
        "text": "This squad may purchase the Extra Crewmember upgrade at half the listed cost."
      },
      "Sponsor Perk§Cult of Plasma": {
        "text": "At the end of the gear phase, if there are more enemy vehicles on plasma-fire than there are friendly vehicles on plasma-fire, or all enemy vehicles are on plasma-fire, this squad gains 1 stream credit for each friendly vehicle that is On Plasma-Fire."
      },
      "Sponsor Perk§Cult of Velocity": {
        "text": "If this vehicle selects the long straight movement template (including when using the NOS Booster upgrade) during gear phase 1, 2, or 3, this vehicle’s controller gains 1 stream credit."
      },
      "Sponsor Perk§Vertigo": {
        "text": "This vehicle may resolve any number of yaw results separately during its movement step, one after another. This can allow this vehicle to yaw more than 90 degrees during its movement step."
      },
      "Sponsor Perk§Dutch Courage": {
        "text": "Vehicles in this squad only blow out when they have 8 strain."
      },
      "Sponsor Perk§Dynamo": {
        "rules": {
          "dynamo": {
            "actions": [
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "assets",
                    "classification",
                    [
                      "Vehicle—Standard",
                      "Vehicle—Restricted"
                    ],
                    "assets",
                    "classification",
                    [
                      "Weapon—Crew Fired",
                      "Weapon—Dropped",
                      "Weapon—Mounted",
                      "Weapon—Restricted",
                      "Upgrade"
                    ],
                    "stats",
                    "Ammo",
                    "increment"
                  ]
                ],
                "value": 1
              }
            ],
            "evals": [],
            "evaluate": "OR",
            "failState": "pass",
            "order": 5
          }
        },
        "text": "After activating in gear Phase 4, 5 or 6, this vehicle may add +1 ammo cell to a single electrical weapon or upgrade on that vehicle."
      },
      "Sponsor Perk§Elegance": {
        "text": "Teams sponsored by Miyaza may not purchase vehicle types with a base Handling value of 2 or lower."
      },
      "Sponsor Perk§Plasma, Walk With Me": {
        "text": "When this vehicle receives damage from any weapon or effect with the Plasma-Fire rule , this vehicle may reduce that damage by up to 3, to a minimum of 1."
      },
      "Sponsor Perk§Tracer-Plasma-Fire": {
        "text": "If a vehicle belonging to this squad explodes, gain +1 stream credit if it was middleweight or +2 stream credits if it was heavyweight in addition to any votes gained for being totaled, and then discard all ammo cells from the total."
      },
      "Sponsor Perk§Ghost Runner": {
        "text": "This vehicle ignores and is ignored by other vehicles at all times. This vehicle cannot be involved in collisions. This vehicle may not make shooting attacks or be attacked with shooting weapons . This vehicle may never count towards the victory conditions of a scenario."
      },
      "Sponsor Perk§Graveyard Throttle": {
        "text": "At the start of the game, after deployment, all vehicle in this squad except one must gain the *Ghost Rider* special rule."
      },
      "Sponsor Perk§Haulage": {
        "rules": {
          "haulage": {
            "actions": [
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{self}",
                    "assets",
                    "item",
                    "Vehicle—Standard§Convoy Rig",
                    "assets",
                    "item",
                    "Special Rule§Articulated",
                    "allowed",
                    "classifications"
                  ]
                ],
                "value": "Cargo"
              }
            ],
            "evals": [],
            "evaluate": "OR",
            "failState": "pass"
          }
        },
        "text": "Each vehicle on this squad equipped with a trailer upgrade, and each Convoy Rig, may equip a single trailer cargo upgrade for free."
      },
      "Sponsor Perk§Hot Pursuit": {
        "text": "Before the first gear phase of the game, after deployment, this squad must nominate one enemy vehicle as the *Bogey*."
      },
      "Sponsor Perk§Inexorable": {
        "text": "If a vehicle from this squad is a total or out of play, the vehicle may be respawned, even if other rules would ordinarily prevent that."
      },
      "Sponsor Perk§Kiss My Asphalt": {
        "rules": {
          "This squad may not purchase Gyrocopters": {
            "evals": [
              {
                "max": 0,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{roster}",
                    "tally",
                    "Drone Lifter"
                  ]
                ]
              }
            ],
            "evaluate": "OR",
            "failState": "error"
          }
        },
        "text": "This squad may not purchase Gyrocopters."
      },
      "Sponsor Perk§Live Fast": {
        "text": "If a vehicle in this squad begins the wipeout step with more strain markers than hull points during its own activation this squad gains +1 stream credit."
      },
      "Sponsor Perk§Maxximum Drift": {
        "text": "If this vehicle resolves two slip results in a single drift check, it may use the medium straight in place of the slip template. If this vehicle resolves three or more slip results in a single drift check, it may use the long straight in place of the slip template."
      },
      "Sponsor Perk§Meshuggah": {
        "text": "When this vehicle resolves a slip or yaw that ends within medium of a friendly vehicle without causing a collision: this squad gains +1 Stream Credit."
      },
      "Sponsor Perk§MicroPlate Armor": {
        "rules": {
          "microplate": {
            "actions": [
              {
                "actionType": "remove",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "included",
                    "classification",
                    [
                      "Vehicle—Restricted",
                      "Vehicle—Standard"
                    ],
                    "allowed",
                    "items"
                  ]
                ],
                "value": "Sponsor Perk§MicroPlate Armor"
              }
            ],
            "evals": [],
            "evaluate": "OR",
            "failState": "pass",
            "order": 10
          }
        },
        "text": "Vehicles in this squad may purchase the MicroPlate Armor upgrade."
      },
      "Sponsor Perk§Might is Right": {
        "rules": {
          "noLight": {
            "actions": [
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "constraints",
                    "none"
                  ]
                ],
                "value": "Light"
              }
            ],
            "evaluate": "AND",
            "failState": "pass"
          },
          "This squad may not purchase lightweight vehicles": {
            "evals": [
              {
                "min": 1,
                "not": true,
                "operator": "AND",
                "paths": [
                  [
                    "{roster}",
                    "tally",
                    "Light"
                  ]
                ]
              }
            ],
            "evaluate": "OR",
            "failState": "error"
          }
        },
        "text": "This squad may not purchase lightweight vehicles."
      },
      "Sponsor Perk§Corporate Hardware": {
        "rules": {
          "tankChopper": {
            "actions": [
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "constraints",
                    "any"
                  ]
                ],
                "value": "Corporate Defense Forces"
              },
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "constraints",
                    "any"
                  ]
                ],
                "value": "Advanced"
              },
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "constraints",
                    "any"
                  ]
                ],
                "value": "Basic"
              }
            ],
            "evaluate": "OR",
            "failState": "pass",
            "order": 10
          }
        },
        "text": "This squad may purchase a single Tank. This squad may purchase a single Tilt-Rotor."
      },
      "Sponsor Perk§NOS Addict": {
        "text": "This squad may purchase the NOS upgrade at half the listed cost."
      },
      "Sponsor Perk§Over the Limit": {
        "text": "This vehicle never considers any of the straight movement templates to be permitted. This vehicle considers veer to be permitted and trivial in any gear."
      },
      "Sponsor Perk§Party Hard": {
        "text": "At the end of this vehicle’s attack step, if this vehicle has more strain markers than the sum of the strain tokens on all other enemy vehicles within medium range combined, this vehicle’s controller gains +1 stream credit for each enemy vehicle with 1+ strain markers within medium range of this vehicle."
      },
      "Sponsor Perk§Pinball": {
        "text": "If a vehicle in this squad is involved in a collision during its movement step in which the point of contact on both vehicles is along their side edges and this vehicle declares a ram attack, then this vehicle may immediately resolve another movement step after the current movement step."
      },
      "Sponsor Perk§Recruitment Squad": {
        "rules": {
          "pressGang": {
            "actions": [
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "assets",
                    "classification",
                    [
                      "Vehicle—Standard",
                      "Vehicle—Restricted"
                    ],
                    "stats",
                    "Crew",
                    "increment"
                  ]
                ],
                "value": 1
              }
            ],
            "evals": [],
            "evaluate": "OR",
            "failState": "pass",
            "order": 5
          }
        },
        "text": "When another vehicle in contact with this vehicle is totaled, this vehicle may gain either 1 crew or 2 stream credits."
      },
      "Sponsor Perk§Detainment Cabs": {
        "text": "Vehicles in this squad may purchase the Detainment Cab upgrade."
      },
      "Sponsor Perk§Runners": {
        "rules": {
          "runners": {
            "actions": [
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "assets",
                    "classification",
                    [
                      "Vehicle—Standard",
                      "Vehicle—Restricted"
                    ],
                    "stats",
                    "Crew",
                    "increment"
                  ]
                ],
                "value": 1
              }
            ],
            "evals": [],
            "evaluate": "OR",
            "failState": "pass",
            "order": 5
          }
        },
        "text": "At the end of the attack step, this vehicle may permanently reduce its crew value by any number, to a minimum of 0 crew: remove 1 hull point from any vehicle in base contact for each crew removed in this way."
      },
      "Sponsor Perk§Raise the Sails": {
        "text": "After rolling drift dice, this vehicle may permanently reduce its crew value by 1, to a minimum of 0 crew to add 1 free throttle result to the drift dice result."
      },
      "Sponsor Perk§Showing Off": {
        "text": "At the end of this vehicle’s activation, if it resolved at least one yaw result, and resolved at least one slip result, and changed gear at least once, and did not wipeout, then this vehicle gains a *Showing Off* token. If a vehicle with a *Showing Off* token blows out, that vehicle must discard its *Showing Off* token. At the end of this vehicle’s activation, if every in-play vehicle on this squad has a *Showing Off* token, this player discards all *Showing Off* tokens and gains 1 stream credit for each *Showing Off* token discarded in this way. Discard all *Showing Off* tokens at the end of the gear phase."
      },
      "Sponsor Perk§Siren": {
        "text": "At the end of this vehicle’s activation, if this vehicle in the Bogey’s rear arc of plasma-fire (regardless of range), the Bogey must either reduce its gear by 1 or gain 2 strain."
      },
      "Sponsor Perk§Soul Anchor": {
        "text": "If all in play vehicles from this squad have the Ghost Rider special rule immediately remove all vehicles on this squad from play."
      },
      "Sponsor Perk§Soul Harvest": {
        "text": "If this vehicle’s movement template comes into contact with an enemy vehicle: this vehicle gains 1 Soul token, even if the enemy vehicle is being ignored. If this vehicle’s movement template comes into contact with a friendly vehicle without the *Ghost Rider* rule that it did not start in contact with, choose one: either gain 1 vote for each Soul token; or repair two Hull Points on the vehicle without the *Ghost Rider* rule for each Soul token. Then discard all Soul tokens."
      },
      "Sponsor Perk§Speed Demon": {
        "text": "When this vehicle gains strain as a result of the NOS Booster, this vehicle only gains strain markers until it has 3 strain markers, rather than 5 strain markers."
      },
      "Sponsor Perk§Spiked Fist": {
        "rules": {
          "spikedFist": {
            "actions": [
              {
                "actionType": "set",
                "iterations": 1,
                "paths": [
                  [
                    "{roster}",
                    "assets",
                    "classification",
                    [
                      "Vehicle—Standard",
                      "Vehicle—Restricted"
                    ],
                    "assets",
                    "item",
                    "Upgrade§Ram-Plate",
                    "stats",
                    "Loadout Slots",
                    "value"
                  ]
                ],
                "value": 0
              }
            ],
            "evals": [],
            "evaluate": "OR",
            "failState": "pass"
          }
        },
        "text": "This vehicle counts the Ram upgrade as requiring zero loadout slots."
      },
      "Sponsor Perk§Corporate Justice": {
        "text": "If the Bogey blows out this squad as a whole gains 2 stream credits. If the Bogey is totaled this squad as a whole gains 4 stream credits."
      },
      "Sponsor Perk§Streamed Carnage": {
        "text": "If a vehicle in this squad causes 6 or more hits in a single attack step, before evades, this squad gains +1 stream credit."
      },
      "Sponsor Perk§That's Entertainment": {
        "text": "Whenever a dropped weapon template that was placed by this squad is removed from play, this squad gains 1 Stream Credit."
      },
      "Sponsor Perk§Thumpermonkey": {
        "text": "This squad may purchase electrical weapons and upgrades."
      },
      "Sponsor Perk§Tombstone": {
        "text": "If the shooting template of a shooting attack touches the rear edge of this vehicle, this vehicle gains +1 to its evade rolls. During this vehicle’s  attack step, this vehicle may gain 2 strain. If it does, all collisions involving this vehicle are considered to be head-on until the start of its next activation."
      },
      "Sponsor Perk§Trailer Trash": {
        "rules": {
          "Add a Convoy Rig or put a trailer on a middleweight or heavy!": {
            "evals": [
              {
                "not": true,
                "operator": "AND",
                "paths": [
                  [
                    "{roster}",
                    "included",
                    "classification",
                    [
                      "Vehicle—Standard",
                      "Vehicle—Restricted"
                    ],
                    "rules",
                    "coyoteTrailers",
                    "return"
                  ]
                ],
                "value": 0
              },
              {
                "min": 1,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{roster}",
                    "tally",
                    "Convoy Rig"
                  ]
                ]
              }
            ],
            "evaluate": "OR",
            "failState": "error"
          }
        },
        "text": "This squad must contain at least one medium or heavyweight vehicle equipped with a trailer upgrade, or a Convoy Rig."
      },
      "Sponsor Perk§Trunk of Junk": {
        "text": "You may attack with any number of dropped weapons in a single activation."
      },
      "Sponsor Perk§Virtuoso": {
        "text": "The first time each vehicle in this squad uses push it in an activation they may push it without gaining a strain marker."
      },
      "Sponsor Perk§Well Stocked": {
        "text": "This squad considers any weapon with the ammo 3 special rule to instead have the ammo 4 special rule when purchased."
      },
