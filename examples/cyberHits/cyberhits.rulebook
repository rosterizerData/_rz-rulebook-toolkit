    "assetCatalog": {
      "Cargo§Quick-Patch Kit": {
        "text": "This vehicle may consider its current gear to be any value, up to this vehicle’s max gear, during the blow-out step, including during any collisions resolved during the blow-out step."
      },
      "Cargo§Stim-Pack": {
        "text": "Whenever a vehicle within medium range of this vehicle gains one or more strain markers, it gains one additional strain marker."
      },
      "Cargo§Adrenal-Pack": {
        "text": "This vehicle’s incendiary bottle cocktail count as having an infinite number of ammo cells."
      },
      "Cargo§Fuel Siphon": {
        "text": "At the start of this vehicle’s attack step, regardless of whether it is distracted, this vehicle may take up to one strain marker from each car within short range of it and place it on this vehicle."
      },
      "Cargo§Coolant-Booster": {
        "text": "At the end of this vehicle’s movement step, if this vehicle has 5 or more strain markers, it must immediately make a long straight maneuver forward."
      },
      "Damage§Crowd Favorite": {
