      },
      "Perk§Reaper Protocol": {
        "keywords": {
          "Tags": [
            "Horror"
          ]
        },
        "stats": {
          "Cost": {
            "value": 4
          }
        },
        "text": "Before making an attack, this vehicle may elect to suffer up to three damage to add that many attack dice to a single weapon used in this attack."
      },
      "Perk§Aileron Roll": {
        "keywords": {
          "Tags": [
            "Built"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "When this vehicle suffers a flip, it may choose to place the flip template touching the centre of either side edge or the rear edge of this vehicle, and perpendicular to that edge, instead of touching the front edge as normal."
      },
      "Perk§Slug-Drive": {
        "keywords": {
          "Tags": [
            "Aggression"
          ]
        },
        "stats": {
          "Cost": {
            "value": 4
          }
        },
        "text": "When making a ram attack, this vehicle gains +1 attack dice for each strain marker it currently has."
      },
      "Perk§Stim-Seeker": {
        "keywords": {
          "Tags": [
            "Reckless"
          ]
        },
        "stats": {
          "Cost": {
            "value": 5
          }
        },
        "text": "When this vehicle would suffer damage outside of its activation, reduce that damage by 1, to a minimum of 1."
      },
      "Perk§Heavyweight Bias": {
        "keywords": {
          "Tags": [
            "Reckless"
          ]
        },
        "stats": {
          "Cost": {
            "value": 4
          }
        },
        "text": "Double any ram attack bonuses or penalties resulting from weight differences in collisions involving this vehicle."
      },
      "Perk§Forced Entry Crew": {
        "keywords": {
          "Tags": [
            "Aggression"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "This vehicle ignores the distracted rule. Crew members in this vehicle may attack during the attack step even if the vehicle is distracted."
      },
      "Perk§Brutalist": {
        "keywords": {
          "Tags": [
            "Built"
          ]
        },
        "stats": {
          "Cost": {
            "value": 4
          }
        },
        "text": "In a collision involving this vehicle, if this vehicle declares a reaction other than evade against an enemy vehicle, the enemy vehicle immediately gains one strain marker."
      },
      "Perk§Slow-Time": {
        "keywords": {
          "Tags": [
            "Hardened"
          ]
        },
        "stats": {
          "Cost": {
            "value": 3
          }
        },
        "text": "If this vehicle resolves a slip result during its movement step, this may select one of its weapons to count as turret-mounted for the rest of the activation."
      },
      "Perk§Chrome-Whisperer": {
        "keywords": {
          "Tags": [
            "Daring"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "This vehicle may *push it* any number of times during a single drift check, gaining 1 strain marker each time."
      },
      "Perk§Drop Cover": {
        "keywords": {
          "Tags": [
            "Hardened"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "Once during its activation this vehicle may remove a strain marker and place it on another friendly vehicle within double range."
      },
      "Perk§Stream-Pleaser": {
        "keywords": {
          "Tags": [
            "Hardened"
          ]
        },
        "stats": {
          "Cost": {
            "value": 1
          }
        },
        "text": "If this vehicle blows out, gain +1 stream credit."
      },
      "Perk§Crusher": {
        "keywords": {
          "Tags": [
            "Built"
          ]
        },
        "rules": {
          "upAndOver": {
            "actions": [
              {
                "actionType": "add",
                "iterations": 1,
                "paths": [
                  [
                    "{parent}",
                    "traits"
                  ]
                ],
                "value": "Special Rule§Run-Over"
              }
            ],
            "evals": [],
            "evaluate": "OR",
            "failState": "pass"
          }
        },
        "stats": {
          "Cost": {
            "value": 7
          }
        },
        "text": "This vehicle gains the Up and Over special rule (see the Urban Crusher rules)."
      },
      "Perk§Ballast Run": {
        "keywords": {
          "Tags": [
            "Built"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "During this vehicle’s attack step, this vehicle may gain 2 strain to count as one weight-class heavier (unless already heavyweight) until the start of its next activation."
      },
      "Perk§Smartlinked": {
        "keywords": {
          "Tags": [
            "Corporate Defense Forces"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "During this vehicle’s attack step this vehicle may gain a +1 bonus to hit if making a shooting attack at a target within double range and not within medium range. \n\nCritical hits still occur only on the natural roll of a 6."
      },
      "Perk§Light Touch": {
        "keywords": {
          "Tags": [
            "Tuning"
          ]
        },
        "stats": {
          "Cost": {
            "value": 3
          }
        },
        "text": "This vehicle ignores the strain icons on maneuver templates."
      },
      "Perk§Lockdown Run": {
        "keywords": {
          "Tags": [
            "Reckless"
          ]
        },
        "stats": {
          "Cost": {
            "value": 4
          }
        },
        "text": "At the start of this vehicle’s activation, it may gain 4 strain markers. If it does, this vehicle cannot gain or lose any strain markers by any means until the start of its next activation."
      },
      "Perk§Twin-Trigger": {
        "keywords": {
          "Tags": [
            "Aggression"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "During the attack step, up to 3 weapons with the Crew Fired special rule may gain a +1 bonus to hit."
      },
      "Perk§Hard Downshift": {
        "keywords": {
          "Tags": [
            "Speed"
          ]
        },
        "stats": {
          "Cost": {
            "value": 3
          }
        },
        "text": "At the end of a movement step in which this vehicle changed down one or more gears, this vehicle may immediately make a forced short straight movement forward."
      },
      "Perk§Aggressive Driver": {
        "keywords": {
          "Tags": [
            "Reckless"
          ]
        },
        "stats": {
          "Cost": {
            "value": 1
          }
        },
        "text": "Gain 1 strain marker at the start of each activation."
      },
      "Perk§Smooth Operator": {
        "keywords": {
          "Tags": [
            "Precision"
          ]
        },
        "stats": {
          "Cost": {
            "value": 5
          }
        },
        "text": "Once per turn, this vehicle may discard one rolled drift die result before applying the results."
      },
      "Perk§Neural Spike": {
        "keywords": {
          "Tags": [
            "Horror"
          ]
        },
        "stats": {
          "Cost": {
            "value": 1
          }
        },
        "text": "Once per activation, at the start of this vehicle’s activation, this vehicle may elect to to gain up to 3 strain markers to discard one strain marker from a friendly vehicle for each strain marker gained."
      },
      "Perk§Cold-Boot Trick": {
        "keywords": {
          "Tags": [
            "Technology"
          ]
        },
        "stats": {
          "Cost": {
            "value": 4
          }
        },
        "text": "Once per game, at the start of its attack step, this vehicle’s controller may declare any weapon that this vehicle has not attacked with yet this game. This vehicle counts as being armed with the declared weapon, on a facing of their choice, for the next attack only."
      },
      "Perk§Evasive": {
        "keywords": {
          "Tags": [
            "Daring"
          ]
        },
        "stats": {
          "Cost": {
            "value": 5
          }
        },
        "text": "Before making an evade roll, this vehicle may gain any number of strain markers to add +1 to each of their evade dice for each strain marker gained. A roll of a ‘1’ on an evade dice always counts as a failure."
      },
      "Perk§Specialist Driver": {
        "keywords": {
          "Tags": [
            "Precision"
          ]
        },
        "stats": {
          "Cost": {
            "value": 3
          },
          "Handling": {
            "statType": "numeric",
            "tracked": true,
            "visibility": "hidden"
          }
        },
        "text": "This vehicle adds +1 to its handling value."
      },
      "Perk§Pain Suppressor": {
        "keywords": {
          "Tags": [
            "Built"
          ]
        },
        "stats": {
          "Cost": {
            "value": 8
          }
        },
        "text": "During an enemy vehicle’s attack step, after an attacker has rolled all of their attack dice against this vehicle, if the attacks causes a total of 2 or fewer un-canceled hits, cancel all remaining hits."
      },
      "Perk§Fender-Kiss": {
        "keywords": {
          "Tags": [
            "Tuning"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "When this vehicle makes a ram attack, this vehicle suffers a penalty of -2 attack dice. Vehicles making a ram attack targeting this vehicle suffer a penalty of -2 attack dice."
      },
      "Perk§Full Mag": {
        "keywords": {
          "Tags": [
            "Corporate Defense Forces"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "If a shooting weapon on this vehicle has 3 or more ammo cells remaining before discarding an ammo cell to attack, that weapon gains +1 attack dice."
      },
      "Perk§Grinder": {
        "keywords": {
          "Tags": [
            "Aggression"
          ]
        },
        "stats": {
          "Cost": {
            "value": 5
          }
        },
        "text": "Before this Vehicle rolls its attack dice in a ram attack, it may choose to add strain markers to the target vehicle for each damage it inflicts, instead of removing hull points."
      },
      "Perk§Gyro-Stabilizer": {
        "keywords": {
          "Tags": [
            "Technology"
          ]
        },
        "stats": {
          "Cost": {
            "value": 1
          }
        },
        "text": "At the start of each game, this vehicle gains a random DARING PERK. This perk is lost at the end of the game."
      },
      "Perk§Drift Artist": {
        "keywords": {
          "Tags": [
            "Daring"
          ]
        },
        "stats": {
          "Cost": {
            "value": 3
          }
        },
        "text": "When applying a yaw result, this vehicle may choose to face any direction."
      },
      "Perk§Cortex Strike": {
        "keywords": {
          "Tags": [
            "Corporate Defense Forces"
          ]
        },
        "stats": {
          "Cost": {
            "value": 4
          }
        },
        "text": "When making a shooting attack, this vehicle’s critical hits inflict 3 hits instead of the normal 2 hits."
      },
      "Perk§Hard Rev": {
        "keywords": {
          "Tags": [
            "Speed"
          ]
        },
        "stats": {
          "Cost": {
            "value": 5
          }
        },
        "text": "This vehicle considers long straight to he permitted in any gear. The long straight is not considered either hazardous or trivial in any gear."
      },
      "Perk§Expressway Zealot": {
        "keywords": {
          "Tags": [
            "Horror"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "At the end of its movement step, if this vehicle selected a straight template, this vehicle may suffer 2 damage. This damage counts as having the ‘Plasma-Fire’ rule. If any hull points are removed by this effect, this vehicle may leave its movement template (ignoring any slip template) in play as a Napalm dropped weapon template. Remove this template at the start of this vehicle’s next activation."
      },
      "Perk§Berserk Surge": {
        "keywords": {
          "Tags": [
            "Reckless"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "This vehicle gains +2 ram attack dice during any collision resolved during a blow out step."
      },
      "Perk§Pre-Heated Start": {
        "keywords": {
          "Tags": [
            "Speed"
          ]
        },
        "stats": {
          "Cost": {
            "value": 1
          }
        },
        "text": "Roll a D6 at the start of the game This vehicle starts the game in that gear. Re-roll if this is above the vehicles max gear."
      },
      "Perk§All-In": {
        "keywords": {
          "Tags": [
            "Reckless"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "If this vehicle has gained six or more strain markers during this activation, it may double the attack dice of any ram attack for this activation only."
      },
      "Perk§Loader": {
        "keywords": {
          "Tags": [
            "Corporate Defense Forces"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "At the start of its attack step, this vehicle may temporarily reduce its crew value by one, once, until the end of the attack step, to gain +1 bonus to hit with a single weapon. Critical hits still occur only on the natural roll of a 6."
      },
      "Perk§Cyber-Madman": {
        "keywords": {
          "Tags": [
            "Hardened"
          ]
        },
        "stats": {
          "Cost": {
            "value": 3
          }
        },
        "text": "At the end of this vehicle’s Movement Step, if it has 4 or more strain markers, it may remove a strain marker and place it on another vehicle within medium range."
      },
      "Perk§Heat-Sink Specialist": {
        "keywords": {
          "Tags": [
            "Precision"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "This vehicle cannot gain more than 2 strain tokens from collisions during a single activation."
      },
      "Perk§Field Tech": {
        "keywords": {
          "Tags": [
            "Technology"
          ]
        },
        "stats": {
          "Cost": {
            "value": 3
          }
        },
        "text": "Once per activation, at the start of its attack step, this vehicle may temporarily reduce its crew value by one, once, until the end of the attack step, to perform a field repair. If it does, this vehicle gains 1 hull point, which may not take its hull points above the vehicle’s hull value."
      },
      "Perk§Stream Highlight": {
        "keywords": {
          "Tags": [
            "Precision"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "Once per game, after rolling the drift dice, but before resolving the results, this vehicle may immediately change any number of drift dice to any results they choose."
      },
      "Perk§Momentum": {
        "keywords": {
          "Tags": [
            "Tuning"
          ]
        },
        "stats": {
          "Cost": {
            "value": 3
          }
        },
        "text": "When resolving drift dice, this vehicle may set aside a Slip or Yaw result to re-roll a drift dice. The effect may be used multiple times.  Set aside results must be resolved."
      },
      "Perk§Hostile-Takeover Rig": {
        "keywords": {
          "Tags": [
            "Aggression"
          ]
        },
        "stats": {
          "Cost": {
            "value": 5
          }
        },
        "text": "This vehicle may make bulldozer ram attacks, like a Convoy Rig."
      },
      "Perk§Pursuit Lock": {
        "keywords": {
          "Tags": [
            "Pursuit"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "When an enemy vehicle resolves a yaw or slip move that ends within short range of this vehicle, that vehicle gains +1 strain marker."
      },
      "Perk§Out-Throttle": {
        "keywords": {
          "Tags": [
            "Pursuit"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "At the start of this vehicle’s attack step, all vehicles within short range of this vehicle and in a current, lower gear than this vehicle gain +1 strain marker."
      },
      "Perk§Overclock": {
        "keywords": {
          "Tags": [
            "Speed"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "When making a drift check, this vehicle may roll one additional drift die. If it does, it must change up at least one gear or gain a strain marker."
      },
      "Perk§PIT Maneuver": {
        "keywords": {
          "Tags": [
            "Pursuit"
          ]
        },
        "stats": {
          "Cost": {
            "value": 4
          }
        },
        "text": "During this vehicle’s activation, if this vehicle is involved in a non-head-on collision with an enemy vehicle, it may declare a *Pursuit Intervention Technique* (PIT) as its reaction, targeting the enemy vehicle, instead of declaring a ram attack or an evade. If this vehicle declares a PIT, it may select any movement template the target vehicle considers hazardous in its current gear. Immediately after the resolution of this collision, the target vehicle must make a forced move directly forward using the selected movement template."
      },
      "Perk§Munitions Keg": {
        "keywords": {
          "Tags": [
            "Hardened"
          ]
        },
        "stats": {
          "Cost": {
            "value": 1
          }
        },
        "text": "This vehicle may add +1 to its explosion check. Treat this vehicle as one weight-class heavier when it explodes.\n\nNote: this bonus does apply during resolution of the FIREWORKS perk."
      },
      "Perk§Power-Drift": {
        "keywords": {
          "Tags": [
            "Daring"
          ]
        },
        "stats": {
          "Cost": {
            "value": 5
          }
        },
        "text": "This vehicle may use any template except the long straight template instead of the slip template when applying a slip result. As with the movement step 1.1, you must use the first maneuver template you touch. Treat the selected maneuver template as a slip template for purposes of finding the vehicle’s final position."
      },
      "Perk§Purifying Plasma": {
        "keywords": {
          "Tags": [
            "Horror"
          ]
        },
        "stats": {
          "Cost": {
            "value": 1
          }
        },
        "text": "Once per activation, at the start of this vehicle’s activation, this vehicle may suffer up to 3 damage to repair one hull point on a friendly vehicle for each hull point removed by this effect. This damage counts as having the *Plasma-Fire* rule. This effect may not be used to raise a vehicle above its hull value."
      },
      "Perk§Smooth Idle": {
        "keywords": {
          "Tags": [
            "Tuning"
          ]
        },
        "stats": {
          "Cost": {
            "value": 6
          }
        },
        "text": "This vehicle does not receive more than 1 strain marker from Yaw results each turn. This vehicle does not receive more than 1 strain marker from Slip results each turn. This vehicle does not receive more than 1 strain marker from Strain results each turn."
      },
      "Perk§Rapid Plasma-Fire": {
        "keywords": {
          "Tags": [
            "Corporate Defense Forces"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "Once per round, after attacking with a weapon, this vehicle may resolve an additional attack step in which it may only attack with that weapon."
      },
      "Perk§Rear Pivot": {
        "keywords": {
          "Tags": [
            "Tuning"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "This vehicle may pivot about the centre of its front edge, rather than the centre of the vehicle, when resolving Yaw results."
      },
      "Perk§Soft Throttle": {
        "keywords": {
          "Tags": [
            "Precision"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "When this vehicle would gain a strain marker for shifting down a gear, this vehicle may remove a strain marker instead."
      },
      "Perk§Counter-Plasma-Fire": {
        "keywords": {
          "Tags": [
            "Corporate Defense Forces"
          ]
        },
        "stats": {
          "Cost": {
            "value": 5
          }
        },
        "text": "Once per gear phase, if this vehicle is the target of a shooting attack, this vehicle may take 2 strain markers to immediately attack, as if it was this vehicle’s attack step."
      },
      "Perk§Street Warrior": {
        "keywords": {
          "Tags": [
            "Hardened"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "Once per activation, if this vehicle has successfully causes one or more hits on an enemy vehicle at any point during this activation, this vehicle may remove a single strain marker at the end of its attack step."
      },
      "Perk§Vector Thrusters": {
        "keywords": {
          "Tags": [
            "Technology"
          ]
        },
        "stats": {
          "Cost": {
            "value": 1
          }
        },
        "text": "When this vehicle is moved as part of a flip, it may choose to use the long straight, veer or gentle templates instead of the medium straight template."
      },
      "Perk§Sat-Link Pilot": {
        "keywords": {
          "Tags": [
            "Technology"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "When this vehicle resolves its drift dice, this vehicle’s controller may set aside one throttle result. This vehicle may have any number of throttle results set aside. Any vehicle in this squad may use these set aside throttle results during a later movement step, as if they had rolled them in that movement step."
      },
      "Perk§Casualty Bonus": {
        "keywords": {
          "Tags": [
            "Pursuit"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "If another vehicle within short range of this vehicle resolves a blow out, (either before or after any flip), remove all strain markers from this vehicle."
      },
      "Perk§Side-Slip": {
        "keywords": {
          "Tags": [
            "Tuning"
          ]
        },
        "stats": {
          "Cost": {
            "value": 6
          }
        },
        "text": "If this vehicle has handling 3 or higher, this vehicle may take 3 strain markers at the end of its activation to be ignored by other vehicles during their movement steps until the start of this vehicle’s next activation. If, by ignoring this vehicle in this way, a vehicle’s final position would overlap it, move that vehicle backwards along their maneuver template by the minimum amount to avoid overlapping any obstruction."
      },
      "Perk§Slippery": {
        "keywords": {
          "Tags": [
            "Daring"
          ]
        },
        "stats": {
          "Cost": {
            "value": 3
          }
        },
        "text": "Vehicles making a ram attack targeting this vehicle suffer a penalty of -2 attack dice."
      },
      "Perk§Slipstream": {
        "keywords": {
          "Tags": [
            "Speed"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "If this vehicle is involved in a tailgate collision during its activation, this vehicle may declare a slipstream reaction. If they do, they other vehicle may not declare a reaction. If this vehicle declares a slipstream reaction: this vehicle may change up or down one gear and gains a strain marker. Neither vehicle gains strain markers as a result of this collision."
      },
      "Perk§Backwash": {
        "keywords": {
          "Tags": [
            "Built"
          ]
        },
        "stats": {
          "Cost": {
            "value": 5
          }
        },
        "text": "Once per step, when this vehicle loses one or more hull points, make a 1D6 attack against each vehicle within medium range at end of that step."
      },
      "Perk§Stunt Driver": {
        "keywords": {
          "Tags": [
            "Daring"
          ]
        },
        "rules": {
          "This perk may only be taken on a lightweight or middleweight vehicle type with a base handling value of 3 or more.": {
            "evals": [
              {
                "not": true,
                "operator": "AND",
                "paths": [
                  [
                    "{parent}",
                    "stats",
                    "Weight",
                    "value"
                  ]
                ],
                "value": "heavy"
              },
              {
                "min": 3,
                "not": false,
                "operator": "AND",
                "paths": [
                  [
                    "{parent}",
                    "stats",
                    "Handling",
                    "processed",
                    "numeric",
                    "default"
                  ]
                ]
              }
            ],
            "evaluate": "AND",
            "failState": "error"
          }
        },
        "stats": {
          "Cost": {
            "value": 7
          }
        },
        "text": "This vehicle may choose to ignore any number of obstructions during its movement step. After any movement step in which this vehicle chooses to ignore any obstruction using this ability, this vehicle immediately gains 3 strain markers."
      },
      "Perk§Black Empathy": {
        "keywords": {
          "Tags": [
            "Horror"
          ]
        },
        "stats": {
          "Cost": {
            "value": 1
          }
        },
        "text": "When this vehicle makes an evade check, it’s controller may select a friendly vehicle within medium range. Add the current gear of the selected vehicle to this vehicle’s current gear for the purposes of this evade check. Both the selected vehicle and this vehicle suffer any unsaved damage from this attack, including any additional effects."
      },
      "Perk§Provoke": {
        "keywords": {
          "Tags": [
            "Pursuit"
          ]
        },
        "stats": {
          "Cost": {
            "value": 2
          }
        },
        "text": "At the start of this vehicle’s attack step, roll a drift die. If you roll something other than a SHIFT result, you may place that drift die result onto the dashboard of a target vehicle within short range. This drift die result must be resolved during that vehicle’s next drift check, and may not be re-rolled."
      },
      "Perk§Cyber-Psycho": {
        "keywords": {
          "Tags": [
            "Aggression"
          ]
        },
        "stats": {
          "Cost": {
            "value": 5
          }
        },
        "text": "Whenever a vehicle controlled by another player ends its movement step within short range of this vehicle, the active vehicle gains a strain marker."
      },
      "Perk§Overtime!": {
        "keywords": {
          "Tags": [
            "Speed"
          ]
        },
        "stats": {
          "Cost": {
            "value": 3
          }
        },
        "text": "At the end of an activation in which this vehicle passes a gate, before checking for wipeouts, this vehicle may immediately remove any number of strain markers."
      },
      "Perk§Trick Driving": {
        "keywords": {
          "Tags": [
            "Precision"
          ]
        },
        "stats": {
          "Cost": {
            "value": 3
          }
        },
        "text": "This vehicle may select a movement template as if its current gear was one higher or one lower."
      },
      "Perk§Dead-Eye Stare": {
        "keywords": {
          "Tags": [
            "Pursuit"
          ]
        },
        "stats": {
          "Cost": {
            "value": 5
          }
        },
        "text": "Enemy vehicles within short range of this vehicle may not use throttle results to remove strain markers from their dashboard."
      },
      "Perk§Violent Glitch": {
        "keywords": {
          "Tags": [
            "Horror"
          ]
        },
        "stats": {
          "Cost": {
            "value": 3
          }
        },
        "text": "When this vehicle is respawned: make an immediate attack (with attack dice based on the weight of the respawned vehicle) against every other vehicle within medium range. This explosion counts as having both the *Blast* and *Plasma-Fire* rules."
      },
      "Perk§Whizbang": {
        "keywords": {
          "Tags": [
            "Technology"
          ]
        },
        "stats": {
          "Cost": {
            "value": 1
          }
        },
        "text": "At the start of each game, this vehicle gains a random SPEED PERK. This perk is lost at the end of the game."
      },
